<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cr.ac.una.est.pos.controller.LoginController"
            prefWidth="750" prefHeight="500"
            style="-fx-background-color: #ecf0f1;">
    <center>
        <VBox alignment="CENTER" spacing="6" BorderPane.alignment="CENTER">

            <Label text="Sistema POS" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Soda o Pulpería" style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;"/>

            <VBox spacing="10" maxWidth="280" alignment="CENTER">
                <padding>
                    <Insets top="30"/>
                </padding>

                <Label text="Usuario:"/>
                <TextField fx:id="txtUsuario" promptText="Ingrese su usuario"/>

                <Label text="Contraseña:"/>
                <PasswordField fx:id="txtContrasena" promptText="Ingrese su contraseña" onAction="#onIngresar"/>

                <Button text="Ingresar" onAction="#onIngresar" maxWidth="Infinity"
                        style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold;">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Button>

                <Label fx:id="lblMensaje" wrapText="true" style="-fx-text-fill: #c0392b;"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>