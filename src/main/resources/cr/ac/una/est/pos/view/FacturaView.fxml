<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cr.ac.una.est.pos.controller.FacturaController"
      spacing="12" prefWidth="450" prefHeight="500">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Resumen de la Orden" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
    <Label fx:id="lblResumenOrden" wrapText="true"/>

    <Separator/>

    <GridPane hgap="10" vgap="6">
        <Label text="Subtotal:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="lblSubtotal" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Costo de envío:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="lblEnvio" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="IVA (13%):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="lblIva" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="TOTAL:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblTotal" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-weight: bold;"/>
    </GridPane>

    <Separator/>

    <Label text="Método de Pago" style="-fx-font-weight: bold;"/>
    <HBox spacing="15">
        <RadioButton fx:id="rbEfectivo" text="Efectivo" selected="true">
            <toggleGroup>
                <ToggleGroup fx:id="tgMetodoPago"/>
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="rbTarjeta" text="Tarjeta" toggleGroup="$tgMetodoPago"/>
        <RadioButton fx:id="rbSinpe" text="SINPE" toggleGroup="$tgMetodoPago"/>
    </HBox>

    <HBox fx:id="boxEfectivo" spacing="10" alignment="CENTER_LEFT">
        <Label text="Monto recibido:"/>
        <TextField fx:id="txtMontoRecibido" prefWidth="100"/>
    </HBox>

    <Button text="Confirmar Pago" onAction="#onConfirmarPago"/>

    <Label fx:id="lblResultado" wrapText="true" style="-fx-font-weight: bold;"/>

</VBox>