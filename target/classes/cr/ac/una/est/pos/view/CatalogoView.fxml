<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cr.ac.una.est.pos.controller.CatalogoController"
            prefWidth="700" prefHeight="450">

    <top>
        <GridPane hgap="10" vgap="8" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="15" right="15" bottom="10" left="15"/>
            </padding>

            <Label text="Código:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCodigo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Categoría:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCategoria" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Precio:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <TextField fx:id="txtPrecio" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

            <Label text="Inventario:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtInventario" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <HBox spacing="10" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="4">
                <padding>
                    <Insets top="10"/>
                </padding>
                <Button text="Agregar" onAction="#onAgregar"/>
                <Button text="Actualizar" onAction="#onActualizar"/>
                <Button text="Eliminar" onAction="#onEliminar"/>
                <Button text="Limpiar" onAction="#onLimpiar"/>
            </HBox>
        </GridPane>
    </top>

    <center>
        <TableView fx:id="tablaProductos" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="80"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
                <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="90"/>
                <TableColumn fx:id="colInventario" text="Inventario" prefWidth="90"/>
            </columns>
            <BorderPane.margin>
                <Insets left="15" right="15" bottom="15"/>
            </BorderPane.margin>
        </TableView>
    </center>

</BorderPane>
