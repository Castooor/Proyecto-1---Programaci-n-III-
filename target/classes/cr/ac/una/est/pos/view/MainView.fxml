<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cr.ac.una.est.pos.controller.MainController"
            prefWidth="750" prefHeight="500">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10;" styleClass="menu-bar">
            <Button text="Catálogo" onAction="#onMostrarCatalogo"/>
            <Button text="Clientes" onAction="#onMostrarClientes"/>
            <Button fx:id="btnNuevaOrden" text="Nueva Orden" onAction="#onMostrarOrdenes"/>
            <Button text="Modo Oscuro/Claro" onAction="#onCambiarModo"/>
            <HBox fx:id="boxSelectorNegocio" spacing="6" alignment="CENTER_LEFT"
                  visible="false" managed="false">
                <Label text="Negocio:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="cbNegocio" onAction="#onCambiarNegocio" prefWidth="120"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblInfoUsuario" text="Modo Soda" style="-fx-font-weight: bold; -fx-padding: 0 10 0 0;"/>
            <Button text="Cerrar Sesión" onAction="#onCerrarSesion"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="panelCentral" BorderPane.alignment="CENTER"/>
    </center>

</BorderPane>
