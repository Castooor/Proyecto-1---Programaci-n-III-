<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cr.ac.una.est.pos.controller.OrdenPulperiaController"
            prefWidth="800" prefHeight="550">

    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="15" right="15" bottom="10" left="15"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Modo Pulpería:" style="-fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                <Label text="Cliente:"/>
                <ComboBox fx:id="cbCliente" prefWidth="220"/>

                <RadioButton fx:id="rbMostrador" text="Venta en Mostrador (Caja)" selected="true">
                    <toggleGroup>
                        <ToggleGroup fx:id="tgTipoOrdenPulperia"/>
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="rbExpress" text="Express (A Domicilio)" toggleGroup="$tgTipoOrdenPulperia"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="lblDireccion" text="Dirección de entrega:" visible="false" managed="false"/>
                <TextField fx:id="txtDireccion" prefWidth="280" visible="false" managed="false" promptText="Dirección del cliente"/>

                <Button text="Iniciar Venta" onAction="#onIniciarOrden" style="-fx-font-weight: bold;"/>
                <Label text="(En mostrador no se requiere mesa)" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="10">
            <padding>
                <Insets left="15" right="15" bottom="15"/>
            </padding>

            <VBox spacing="8" prefWidth="380">
                <Label text="Abarrotes y Productos de la Pulpería" style="-fx-font-weight: bold;"/>
                <TableView fx:id="tablaCatalogo" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="colCatCodigo" text="Código" prefWidth="70"/>
                        <TableColumn fx:id="colCatNombre" text="Nombre" prefWidth="140"/>
                        <TableColumn fx:id="colCatPrecio" text="Precio" prefWidth="80"/>
                        <TableColumn fx:id="colCatInventario" text="Stock" prefWidth="70"/>
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Cantidad:"/>
                    <TextField fx:id="txtCantidad" prefWidth="60"/>
                    <Button text="Agregar a la canasta" onAction="#onAgregarAlCarrito"/>
                </HBox>
            </VBox>

            <VBox spacing="8">
                <Label text="Canasta de Compra / Mostrador" style="-fx-font-weight: bold;"/>
                <TableView fx:id="tablaCarrito" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="colCarProducto" text="Producto" prefWidth="150"/>
                        <TableColumn fx:id="colCarCantidad" text="Cantidad" prefWidth="80"/>
                        <TableColumn fx:id="colCarSubtotal" text="Subtotal" prefWidth="90"/>
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Quitar de la canasta" onAction="#onQuitarDelCarrito"/>
                    <Button text="Cobrar / Facturar" onAction="#onFacturar" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lblSubtotal" text="Subtotal: ₡0" style="-fx-font-weight: bold;"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>
